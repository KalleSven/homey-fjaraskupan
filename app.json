          "en": "Set light level to [[level]]",
          "sv": "Ställ in ljusstyrka till [[level]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hood"
          },
          {
            "name": "level",
            "type": "range",
            "min": 0,
            "max": 1,
            "step": 0.01,
            "label": "%",
            "labelMultiplier": 100,
            "labelDecimals": 0
          }
        ]
      },
      {
        "id": "set_fan_speed",
        "title": {
          "en": "Set fan speed",
          "sv": "Ställ in fläkthastighet"
