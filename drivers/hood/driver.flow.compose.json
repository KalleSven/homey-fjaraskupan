  "actions": [
    {
      "id": "light_on",
      "title": {
        "en": "Turn on light",
        "sv": "Tänd belysning"
      },
      "hint": {
        "en": "Turns on the cooker hood light.",
        "sv": "Tänder belysningen på köksfläkten."
      }
    },
    {
      "id": "light_off",
      "title": {
        "en": "Turn off light",
        "sv": "Släck belysning"
      },
      "hint": {
        "en": "Turns off the cooker hood light.",
        "sv": "Släcker belysningen på köksfläkten."
      }
    },
    {
      "id": "set_light_dim",
      "title": {
        "en": "Set light level",
        "sv": "Ställ in ljusstyrka"
      },
      "hint": {
        "en": "Sets the light level. 0% turns the light off.",
        "sv": "Ställer in ljusstyrkan. 0 % släcker belysningen."
      },
      "titleFormatted": {
        "en": "Set light level to [[level]]",
        "sv": "Ställ in ljusstyrka till [[level]]"
      },
      "args": [
        {
          "name": "level",
          "type": "range",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "label": "%",
          "labelMultiplier": 100,
          "labelDecimals": 0
        }
      ]
    },
    {
      "id": "set_fan_speed",
      "title": {
        "en": "Set fan speed",
        "sv": "Ställ in fläkthastighet"
      },
      "hint": {
        "en": "Sets the cooker hood fan speed.",
