        "en": "Set after cooking to [[mode]]",
        "sv": "Ställ in efterkörning till [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "off",
              "label": {
                "en": "Off",
                "sv": "Av"
              }
            },
            {
              "id": "auto",
              "label": {
                "en": "Automatic",
                "sv": "Automatisk"
              }
            },
            {
              "id": "manual",
              "label": {
                "en": "Manual",
                "sv": "Manuell"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "venting_on",
      "title": {
        "en": "Turn on periodic venting",
        "sv": "Slå på periodisk ventilation"
      },
      "hint": {
        "en": "Uses the interval from the device settings.",
        "sv": "Använder intervallet från enhetens inställningar."
      }
    },
    {
      "id": "venting_off",
      "title": {
        "en": "Turn off periodic venting",
        "sv": "Stäng av periodisk ventilation"
      },
      "hint": {
        "en": "Turns off periodic venting.",
        "sv": "Stänger av periodisk ventilation."
      }
    },
    {
      "id": "reset_grease_filter",
      "title": {
        "en": "Reset grease filter",
        "sv": "Återställ fettfilter"
      },
      "hint": {
        "en": "Resets the grease filter alarm after cleaning.",
        "sv": "Återställer fettfilterlarmet efter rengöring."
      }
    },
    {
      "id": "reset_carbon_filter",
      "title": {
        "en": "Reset carbon filter",
        "sv": "Återställ kolfilter"
      },
      "hint": {
        "en": "Resets the carbon filter alarm after replacing the filter.",
        "sv": "Återställer kolfilterlarmet efter filterbyte."
